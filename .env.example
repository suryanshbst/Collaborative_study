# ==========================================================================
# StudySphere — Root Environment File (used by docker-compose)
# ==========================================================================
# Copy this file to ".env" in the project root ON THE SERVER and fill in real
# values. docker-compose reads this file for:
#   1. `env_file` -> injected into the backend & web containers at runtime.
#   2. `${VAR}` interpolation -> passed as FRONTEND BUILD ARGS (see below).
#
#   cp .env.example .env   &&   nano .env
#
# IMPORTANT: The NEXT_PUBLIC_* values are compiled into the browser bundle at
# BUILD time, NOT read at runtime. If you change them you MUST rebuild the web
# image:   docker compose build web  &&  docker compose up -d
# --------------------------------------------------------------------------

# ---- Database (backend) --------------------------------------------------
# Your Postgres / Neon / Supabase connection string.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ---- Auth (backend) ------------------------------------------------------
JWT_SECRET="change-me-to-a-long-random-production-secret"

# ---- Backend runtime -----------------------------------------------------
PORT=8000
NODE_ENV=production

# CORS: the public origin(s) allowed by the backend (comma-separated list).
# EC2 DNS hostnames (*.amazonaws.com) and IPv4 addresses are also auto-allowed.
FRONTEND_URL="http://ec2-98-82-153-41.compute-1.amazonaws.com,http://98.82.153.41"

# ---- Frontend public URLs (BUILD-TIME, inlined into the client) ----------
# In production behind Nginx, the frontend automatically routes API calls to the
# active browser origin (matching EC2 DNS, IP, or custom domain seamlessly).
# You can also explicitly specify your public domain or EC2 address here:
#
#   HTTP  (current):  http://ec2-98-82-153-41.compute-1.amazonaws.com
#   HTTPS (with SSL): https://your-domain.com   /   wss://your-domain.com
NEXT_PUBLIC_BACKEND_URL="http://ec2-98-82-153-41.compute-1.amazonaws.com"
NEXT_PUBLIC_WS_URL="ws://ec2-98-82-153-41.compute-1.amazonaws.com"
