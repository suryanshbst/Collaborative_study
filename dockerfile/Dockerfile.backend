# ==========================================
# StudySphere Backend Dockerfile (Production)
# Multi-stage build with Bun & Prisma
# ==========================================

FROM oven/bun:1.3-slim AS builder

WORKDIR /app

# Install OpenSSL required by Prisma engine
RUN apt-get update -y && apt-get install -y openssl ca-certificates && rm -rf /var/lib/apt/lists/*

# Copy Monorepo configuration and lockfile
COPY package.json bun.lock turbo.json ./

# Copy Package definitions
COPY packages/db/package.json ./packages/db/
COPY packages/zod/package.json ./packages/zod/
COPY apps/backend/package.json ./apps/backend/

# Install Monorepo dependencies
RUN bun install

# Copy Source Code (untouched)
COPY packages/db ./packages/db
COPY packages/zod ./packages/zod
COPY apps/backend ./apps/backend

# Generate Prisma Client (provide dummy DATABASE_URL solely for build-time code generation)
WORKDIR /app/packages/db
ENV DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres?sslmode=disable"
RUN bun x prisma generate

WORKDIR /app

# Set Production Environment
ENV NODE_ENV=production
ENV PORT=8000

EXPOSE 8000

# Start Express + WebSocket Server
CMD ["bun", "run", "apps/backend/index.ts"]
