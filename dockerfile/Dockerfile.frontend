# ==========================================
# StudySphere Frontend Dockerfile (Production)
# Multi-stage build with Bun & Next.js
# ==========================================

# 1. Base / Dependencies Stage
FROM oven/bun:1.3-slim AS base
WORKDIR /app

# Copy Monorepo structure
COPY package.json bun.lock turbo.json ./
COPY packages/ui/package.json ./packages/ui/
COPY packages/zod/package.json ./packages/zod/
COPY packages/typescript-config/package.json ./packages/typescript-config/
COPY packages/eslint-config/package.json ./packages/eslint-config/
COPY apps/web/package.json ./apps/web/

# Install Monorepo dependencies
RUN bun install

# 2. Builder Stage
FROM base AS builder
WORKDIR /app

# Copy source code across packages
COPY packages ./packages
COPY apps/web ./apps/web

# Build Arguments for client-side environment variables
ARG NEXT_PUBLIC_BACKEND_URL
ARG NEXT_PUBLIC_WS_URL

ENV NEXT_PUBLIC_BACKEND_URL=${NEXT_PUBLIC_BACKEND_URL}
ENV NEXT_PUBLIC_WS_URL=${NEXT_PUBLIC_WS_URL}
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

# Build Next.js application
WORKDIR /app/apps/web
RUN bun run build

# 3. Production Runner Stage
FROM oven/bun:1.3-slim AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000
ENV NEXT_TELEMETRY_DISABLED=1

# Copy built application and workspace modules
COPY --from=builder /app /app

WORKDIR /app/apps/web

EXPOSE 3000

CMD ["bun", "run", "start"]
